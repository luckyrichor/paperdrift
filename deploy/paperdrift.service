[Unit]
Description=paperdrift wallpaper curator
After=network-online.target
Wants=network-online.target

[Service]
User=paperdrift
Group=paperdrift
WorkingDirectory=/opt/paperdrift
EnvironmentFile=/opt/paperdrift/.env
ExecStart=/opt/paperdrift/.venv/bin/python -m app.serve
Restart=on-failure
RestartSec=5
# 允许非 root 用户监听 443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/paperdrift/data

[Install]
WantedBy=multi-user.target
