# 复制为 .env 并填写。.env 已在 .gitignore 中，绝不要提交。
# 登录密码（网页和 apk 共用，务必设强密码）
PAPERDRIFT_PASSWORD=change-me-to-a-long-passphrase
# 会话签名密钥（setup.sh 会自动生成；手动生成: python3 -c "import secrets;print(secrets.token_hex(32))"）
PAPERDRIFT_SECRET=
# 数据目录（数据库、预览图、已喜欢的原图）
PAPERDRIFT_DATA_DIR=./data
# 监听地址/端口；启用 HTTPS 时填证书路径，端口通常为 443
PAPERDRIFT_HOST=0.0.0.0
PAPERDRIFT_PORT=8000
PAPERDRIFT_SSL_CERT=
PAPERDRIFT_SSL_KEY=
# HTTPS 下设为 1，cookie 只经加密连接发送
PAPERDRIFT_COOKIE_SECURE=0
# 单个原图/视频下载上限（MB）
PAPERDRIFT_MAX_DOWNLOAD_MB=300
# 可选：Wallhaven API Key（不填也能搜 SFW）
WALLHAVEN_API_KEY=
# 可选：DeepSeek API Key —— 用来把中文描述翻译成英文搜索标签（不填则只能直接用英文关键词）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 可选：Danbooru 账号（免费账号标签数限制为 2 个）
DANBOORU_LOGIN=
DANBOORU_API_KEY=

# --- Steam 创意工坊（可选）---
# 搜索不需要任何配置；想「点喜欢就在服务器上下载好」需要装 SteamCMD，并用拥有 Wallpaper Engine 的账号手动登录一次。
# 这里只写用户名；密码和令牌验证码只在服务器终端里输入，绝不写进任何文件。
STEAM_USER=
STEAMCMD_PATH=/opt/steamcmd/steamcmd.sh
STEAM_MAX_MB=2048
# 可选：Steam Web API Key（有了搜索更稳；没有也能用）
STEAM_API_KEY=
